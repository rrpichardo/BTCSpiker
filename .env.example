# Runtime settings for docker-compose.yaml and the helper scripts.
# Copy this file to .env before starting the stack. The API mounts .env
# read-only so the web UI can compare saved settings with active settings.
# NEVER commit .env to version control.

# Root stack defaults used by the canonical `docker compose up -d` path.
REPLAY_SPEED=1.0
MODEL_VARIANT=ml
BASELINE_VOL_THRESHOLD=0.000048
MODEL_NAME=btc-volatility-lr
MODEL_STAGE=Production
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Advanced Docker-internal overrides.
# These values are normally correct as-is for the compose-managed stack, but the
# runtime reads them directly so they are documented here for completeness.
KAFKA_BOOTSTRAP=kafka:29092
TOPIC_RAW=ticks.raw
TOPIC_FEATURES=ticks.features
TOPIC_PREDICTIONS=ticks.predictions
TOPIC_OUTCOMES=ticks.outcomes
KAFKA_GROUP_ID=predict-bridge
KAFKA_OUTCOMES_GROUP_ID=materializer-outcomes

# Performance-tab grading knobs (materializer/evaluation.py). MIN_POSITIVES
# gates PR-AUC on having enough real spikes to rank; MIN_NOTE_SAMPLE_N and
# DRIFT_PR_AUC_RATIO gate the benchmark note that appears when live PR-AUC
# sits well below the training-time reference — see docs/runbook.md.
MIN_POSITIVES=10
MIN_NOTE_SAMPLE_N=1000
DRIFT_PR_AUC_RATIO=0.7
PREDICT_API_URL=http://api:8000/predict
PREDICT_API_HEALTH_URL=http://api:8000/health
PREDICT_API_TIMEOUT=10
STARTUP_TIMEOUT=30
RETRY_BACKOFF=2
MODEL_PATH=models/artifacts/lr_pipeline.pkl
MODEL_VERSION=v1.0

# Read-only settings files mounted into the API container.
SETTINGS_ENV_FILE=/app/runtime/.env
SETTINGS_CONFIG_FILE=/app/runtime/config.yaml

# Docker-internal health probes used by GET /system/status.
SYSTEM_PROBE_API_URL=http://localhost:8000/health
SYSTEM_PROBE_GRAFANA_URL=http://grafana:3000/api/health
SYSTEM_PROBE_PROMETHEUS_URL=http://prometheus:9090/-/healthy
SYSTEM_PROBE_MLFLOW_URL=http://mlflow:5000/health
SYSTEM_PROBE_MATERIALIZER_URL=http://materializer:8090/health
SYSTEM_PROBE_TIMEOUT=2
SYSTEM_STATUS_CACHE_SECONDS=5
SYSTEM_MATERIALIZER_STALE_SECONDS=60

# Browser-facing links returned by GET /system/status.
SYSTEM_OPEN_API_URL=http://localhost:8000/docs
SYSTEM_OPEN_GRAFANA_URL=http://localhost:3000
SYSTEM_OPEN_PROMETHEUS_URL=http://localhost:9090
SYSTEM_OPEN_MLFLOW_URL=http://localhost:5001
SYSTEM_OPEN_MATERIALIZER_URL=http://localhost:8090/health

# Local-shell helpers for running scripts outside Docker.
# The root compose stack does not use these because compose wires Kafka and
# MLflow to internal service addresses directly.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MLFLOW_TRACKING_URI=http://localhost:5001

# Optional metadata/debug injection.
# The API computes the short git SHA from the repository when available; this is
# only used as an override when git metadata is unavailable at startup.
GIT_SHA=unknown

# Note: ws_ingest.py uses the public Coinbase advanced-trade-ws ticker channel,
# which requires no authentication. No API keys are needed to run live mode.
